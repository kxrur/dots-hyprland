// User window rules (mirrors hypr/custom/rules.lua).

// ---- Named workspaces: 1-5 primary (DP-2), 6-9 second monitor (HDMI-A-2) ----
workspace "1" {
    open-on-output "DP-2"
}
workspace "2" {
    open-on-output "DP-2"
}
workspace "3" {
    open-on-output "DP-2"
}
workspace "4" {
    open-on-output "DP-2"
}
workspace "5" {
    open-on-output "DP-2"
}
workspace "6" {
    open-on-output "HDMI-A-2"
}
workspace "7" {
    open-on-output "HDMI-A-2"
}
workspace "8" {
    open-on-output "HDMI-A-2"
}
workspace "9" {
    open-on-output "HDMI-A-2"
}

// ---- Steam + games ----
window-rule {
    match app-id="^steam$"
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"steam_app_.*|cs2|momentum|osu!|overwatch\.exe|gunfire reborn\.exe"#
    open-on-workspace "1"
}

window-rule {
    match title="^FFXIVLauncher$"
    open-on-workspace "1"
    open-floating true
}

// ---- Browser ----
window-rule {
    match app-id="^zen$"
    open-on-workspace "2"
}

// ---- Utilities ----
window-rule {
    match app-id=r#"^org\.coolercontrol\.CoolerControl$"#
    open-on-workspace "4"
}

window-rule {
    match app-id="^[Hh]eroic$"
    open-on-workspace "5"
}

window-rule {
    match app-id="^(Emulator|scrcpy)$"
    open-floating true
}
