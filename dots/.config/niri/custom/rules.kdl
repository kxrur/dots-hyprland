// User window rules (mirrors hypr/custom/rules.lua).
//
// niri's `open-on-workspace` only targets NAMED workspaces, so the numbered
// workspace assignments from Hyprland are kept commented with the equivalent
// named form. Define/bind the named workspaces you want to use.

// ---- Floating by app-id ----
window-rule {
    match app-id="Emulator|scrcpy"
    open-floating true
}

window-rule {
    match title="FFXIVLauncher"
    open-floating true
}

// ---- Borderless / fullscreen launches ----
// Hyprland "fake fullscreen" (fullscreen_state 0 2) for these apps.
