// User keybinds (mirrors hypr/custom/keybinds.lua).
// These come after niri/keybinds.kdl, so they override conflicting keys.

binds {
    // ---- Apps ----
    Mod+Return { spawn "kitty"; }
    Ctrl+Alt+T { spawn "kitty"; }
    Mod+E { spawn "dolphin"; }
    Mod+W { spawn "zen-browser"; }
    Mod+C { spawn-sh "~/.config/hypr/hyprland/scripts/launch_first_available.sh windsurf antigravity code codium cursor zed zedit zeditor kate emacs"; }
    Mod+X { spawn-sh "~/.config/hypr/hyprland/scripts/launch_first_available.sh kate gnome-text-editor emacs"; }
    Mod+Ctrl+V { spawn-sh "~/.config/hypr/hyprland/scripts/launch_first_available.sh pavucontrol-qt pavucontrol"; }
    // DMS built-in process list (Hyprland used an external task manager):
    Ctrl+Shift+Escape { spawn-sh "dms ipc call processlist focusOrToggle"; }
    // Standalone fallback:
    // Ctrl+Shift+Escape { spawn-sh "~/.config/hypr/hyprland/scripts/launch_first_available.sh gnome-system-monitor 'plasma-systemmonitor --page-name Processes' 'kitty -1 fish -c btop'"; }

    // ---- Edit this config ----
    Mod+Ctrl+Alt+Slash { spawn-sh "xdg-open ~/.config/niri/config.kdl"; }
}
