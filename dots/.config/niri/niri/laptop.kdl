// Laptop overrides, always included on the laptop branch.
// These reproduce the two remaps the Rainy 75 does in its VIA firmware
// (see dots/.config/via): caps:escape + Alt/Win swap. The Fn layer is not
// emulated -- keys the built-in keyboard lacks stay unavailable.
//
// Touchpad settings are owned by DMS (dms/input.kdl) and the eDP-1 output by
// dms/outputs.kdl, so neither is overridden here.

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle,caps:escape,altwin:swap_lalt_lwin"
        }
        repeat-delay 250
        repeat-rate 35
        numlock
    }
}
