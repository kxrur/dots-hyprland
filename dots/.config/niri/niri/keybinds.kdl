// Default keybinds, mapped from hypr/hyprland/keybinds.lua + custom overrides.
// Shell actions call DankMaterialShell via `dms ipc call ...`.
// Personal app binds live in custom/keybinds.kdl.

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Slash { spawn-sh "dms ipc call keybinds open"; }

    // ---- Focus ----
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+BracketLeft { focus-column-left; }
    Mod+BracketRight { focus-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // ---- Move ----
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    // ---- Monitors ----
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }

    // ---- Workspaces (1-5, matching the Hyprland desktop branch) ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }

    // ---- Overview / switcher ----
    Mod+Tab { focus-monitor-next; }
    Mod+grave { toggle-overview; }
    // Alt-Tab window switcher is provided by the DMS-managed dms/alttab.kdl.

    // ---- Layout / window state ----
    Mod+Shift+O { toggle-column-tabbed-display; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Semicolon { set-column-width "-10%"; }
    Mod+Apostrophe { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+D { maximize-column; }
    Mod+Alt+Space { toggle-window-floating; }
    Mod+Shift+F { maximize-window-to-edges; }

    // Hyprland fake fullscreen (fullscreen_state internal=0 client=2):
    // the client thinks it's fullscreen; niri does not fullscreen it.
    Mod+Alt+F repeat=false { toggle-windowed-fullscreen; }

    // ---- DMS surfaces ----
    Mod+D { spawn-sh "dms ipc call spotlight toggle"; }
    Mod+A { spawn-sh "dms ipc call control-center toggle"; }
    Mod+N { spawn-sh "dms ipc call notifications toggle"; }
    Mod+V { spawn-sh "dms ipc call clipboard toggle"; }
    Ctrl+Alt+Delete { spawn-sh "dms ipc call powermenu toggle"; }
    Mod+I { spawn-sh "dms ipc call settings focusOrToggle"; }
    Mod+G { spawn-sh "dms ipc call bar toggle"; }
    // Mod+Period { spawn-sh "dms ipc call spotlight openQuery ':'"; } // emoji (query syntax TBD)

    // ---- Wallpaper / theme ----
    Mod+Ctrl+T { spawn-sh "dms ipc call dankdash wallpaper"; }
    Mod+Ctrl+Alt+T { spawn-sh "dms ipc call wallpaper next"; }
    Mod+Ctrl+Shift+D { spawn-sh "dms ipc call theme toggle"; }
    Mod+Ctrl+R { spawn-sh "dms restart"; }

    // ---- Screenshots ----
    Mod+Shift+S { spawn-sh "dms screenshot region"; }
    Print { spawn-sh "dms screenshot full"; }
    Ctrl+Print { spawn-sh "dms screenshot full"; }
    // Mod+Shift+A { spawn-sh "dms screenshot window"; } // DMS has no annotate

    // ---- Session ----
    Mod+Shift+U { spawn-sh "systemctl suspend"; }
    Mod+Ctrl+Shift+U { spawn-sh "dms ipc call lock lock"; }
    Ctrl+Shift+Alt+Mod+Delete { spawn-sh "dms ipc call powermenu toggle"; }
    Mod+Shift+E { quit; }

    // ---- VM / shortcut inhibitor (Hyprland virtual-machine submap) ----
    Mod+Alt+F1 { toggle-keyboard-shortcuts-inhibit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // Mod+Alt+C { spawn-sh "dms ipc call inhibit toggle"; }  // caffeine / idle inhibit
    // Mod+Alt+N { spawn-sh "dms ipc call night toggle"; }    // night light

    // ---- Audio / brightness ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "dms ipc call audio increment 3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "dms ipc call audio decrement 3"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "dms ipc call audio mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "dms ipc call audio micmute"; }
    // Volume on Super+Shift+wheel (Hyprland SUPER+SHIFT+mouse_up/down).
    Mod+Shift+WheelScrollUp cooldown-ms=50 { spawn-sh "dms ipc call audio increment 3"; }
    Mod+Shift+WheelScrollDown cooldown-ms=50 { spawn-sh "dms ipc call audio decrement 3"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "dms ipc call brightness increment 5 \"\""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "dms ipc call brightness decrement 5 \"\""; }

    // ---- Media ----
    XF86AudioPlay allow-when-locked=true { spawn-sh "dms ipc call mpris playPause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "dms ipc call mpris playPause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "dms ipc call mpris next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "dms ipc call mpris previous"; }
    Mod+Shift+P { spawn-sh "dms ipc call mpris playPause"; }
    Mod+Shift+B { spawn-sh "dms ipc call mpris previous"; }
    Mod+Shift+N { spawn-sh "dms ipc call mpris next"; }
    Mod+Shift+M { spawn-sh "dms ipc call audio mute"; }
    Mod+Alt+M { spawn-sh "dms ipc call audio micmute"; }

    // ---- Color picker (DMS built-in) ----
    Mod+Shift+C { spawn-sh "dms ipc call color-picker toggle"; }

    // ---- Utilities kept commented for future use ----
    // Mod+Shift+X { spawn-sh "~/.config/hypr/hyprland/scripts/ocr.sh"; } // OCR
    // Mod+Shift+T { spawn-sh "~/.config/hypr/hyprland/scripts/translate.sh"; } // screen translate
    // Mod+Shift+R { spawn-sh "~/.config/hypr/hyprland/scripts/record.sh"; } // region record
    // Mod+Alt+R { spawn-sh "~/.config/hypr/hyprland/scripts/record.sh"; }   // region record
    // Ctrl+Alt+R { spawn-sh "~/.config/hypr/hyprland/scripts/record.sh --fullscreen"; }
    // Mod+Shift+Alt+R { spawn-sh "~/.config/hypr/hyprland/scripts/record.sh --fullscreen --sound"; }
    // Mod+Shift+Alt+MouseRight { spawn-sh "~/.config/hypr/hyprland/scripts/ai/primary-buffer-query.sh"; } // AI summary
    // Mod+Shift+Home { spawn-sh "~/.config/hypr/hyprland/scripts/toggle_window_mute.sh"; } // mute focused window

    // Window dragging: niri uses Mod + left mouse drag for floating windows.
    // Mod+Z { ... } // Hyprland "window drag" has no direct equivalent
}

// Alt-Tab switching between recent windows (highlight styling in dms/alttab.kdl).
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
