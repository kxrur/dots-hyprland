input {
    mouse {
        accel-speed 0.0
        accel-profile "flat"
        scroll-factor 1.2
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        dwt
        scroll-factor 0.1
    }
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
    }
}

