// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=wr_1790027369325156707 @name=org.freedesktop.impl.portal.desktop.kde
window-rule {
    match app-id="^org.freedesktop.impl.portal.desktop.kde$" is-floating=true
}

